# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- General ---
APP_NAME=NEXUS AI
ENV=development

# --- Embeddings ---
# "tfidf-svd" works offline with no external downloads (the default).
# "sentence-transformers" requires network access to huggingface.co to
# download sentence-transformers/all-MiniLM-L6-v2 on first run.
EMBEDDING_BACKEND=tfidf-svd

# --- LLM (optional) ---
# If unset, the app runs in a clearly-labeled "demo mode" that returns
# retrieved excerpts directly instead of an LLM-generated answer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Auth ---
# Generate a real secret for any non-local deployment, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_INSECURE_DEV_ONLY_SECRET
JWT_EXPIRE_MINUTES=1440

# --- Uploads ---
MAX_FILE_SIZE_MB=25
